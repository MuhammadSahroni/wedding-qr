{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-checkin-app",
  "main": "nextjsapp/.open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "nextjsapp/.open-next/assets",
    "binding": "ASSETS"
  }
}
