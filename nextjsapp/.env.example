# ============================================================
# Google Spreadsheet API Configuration
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME="Daftar Hadir"

# ============================================================
# Pusher Realtime (Channels Free Tier)
# ============================================================
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap1

# Public variables for Next.js Client
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# ============================================================
# Convex Realtime Database
# ============================================================
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
