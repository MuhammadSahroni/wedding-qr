{
  "name": "wedding-checkin-system",
  "version": "1.0.0",
  "description": "Sistem Check-In Tamu QR Code - Resepsi Pernikahan Wildan & Aisyah",
  "scripts": {
    "build": "cd nextjsapp && npm install && npm run build:worker",
    "build:worker": "cd nextjsapp && npm run build:worker",
    "deploy": "cd nextjsapp && npx wrangler deploy",
    "dev": "cd nextjsapp && npm run dev",
    "start": "cd nextjsapp && npm run start"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "google-auth-library": "^11.1.0",
    "google-spreadsheet": "^5.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.48.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0"
  }
}
